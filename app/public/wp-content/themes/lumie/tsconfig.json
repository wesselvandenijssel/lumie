{
	"compilerOptions": {
		"target": "ES2015",
		"lib": ["ES2015", "DOM"],
		"module": "commonjs",
		"moduleResolution": "node",
		"strict": false,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true
	},
	"ts-node": {
		"compilerOptions": {
			"esModuleInterop": true,
			"module": "commonjs",
			"moduleResolution": "node",
			"noEmit": true,
			"allowSyntheticDefaultImports": true,
			"target": "ES6"
		}
	},
	"exclude": ["playwright.config.ts"]
}
